{
  "manifest_version": 3,
  "name": "osu! Private Server Ranking",
  "description": "複数のbancho.py系サーバーのスコアをosu! beatmapページへ統合表示します。",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://osu.ppy.sh/beatmapsets/*", "https://osu.ppy.sh/beatmaps/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
